    },
    {
      "name": "not found",
      "valid": true,
      "value": {
        "outcome": "not_found"
      }
    },
    {
      "name": "an extra field, which a reply may carry",
      "valid": true,
      "unknownFields": true,
      "value": {
        "outcome": "cancelled",
        "status": "cancelled",
        "extra": 1
      }
    },
    {
      "name": "no outcome",
      "valid": false,
      "value": {
        "status": "cancelled"
      }
    },
    {
      "name": "an unknown outcome",
      "valid": false,
      "value": {
        "outcome": "gone"
      }
    }
  ]
}
