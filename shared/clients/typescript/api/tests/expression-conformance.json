{
  "functions": {
    "add": { "minArgs": 2, "maxArgs": null },
    "subtract": { "minArgs": 2, "maxArgs": 2 },
    "multiply": { "minArgs": 2, "maxArgs": null },
    "divide": { "minArgs": 2, "maxArgs": 2 },
    "min": { "minArgs": 2, "maxArgs": null },
    "max": { "minArgs": 2, "maxArgs": null },
    "round": { "minArgs": 1, "maxArgs": 2 },
    "uppercase": { "minArgs": 1, "maxArgs": 1 },
    "lowercase": { "minArgs": 1, "maxArgs": 1 },
    "random": { "minArgs": 2, "maxArgs": 2 }
  },
  "valid": [
    "no expression at all",
    "${trigger.data.amount}",
    "${trigger.data.amount > 1 ? 'subs' : 'sub'}",
    "${'unterminated}",
    "${trigger.data.amount > }",
    "${asset:clip(1).mp3}",
    "${woofx3_asset_url:modules/x/clip(1).mp3}",
    "${round(trigger.data.amount)}",
    "${round (trigger.data.amount)}",
    "${round(trigger.data.amount, 2)}",
    "${add(1, 2, 3, 4)}",
    "${add(trigger.data.amount || 0, -1)}",
    "${round(divide(trigger.data.bits, 100), 2)}",
    "${max(trigger.data.a > 1 ? 1 : 2, (3))}",
    "${uppercase('a, b (c)')}",
    "${uppercase(\"it's\")}",
    "${trigger.data.amount > 1 ? round(trigger.data.amount) : 'none'}",
    "Rolled ${random(1, 6)} and ${trigger.data.userName}!",
    "${trigger.data.name == 'foo(' ? 1 : 2}"
  ],
  "invalid": [
    "${foo(1)}",
    "${trigger.data.round(1)}",
    "${toString(1)}",
    "${constructor(1)}",
    "${add(1)}",
    "${add()}",
    "${round(1, 2, 3)}",
    "${round(}",
    "${round(1}",
    "${add(1,)}",
    "${add(,1)}",
    "${add(1 2)}",
    "${round(1) 2}",
    "${uppercase('a}')}",
    "${uppercase('a)}",
    "${true ? foo(1) : 2}",
    "${round(foo(1))}",
    "Hello ${trigger.data.userName}, ${foo(1)} there"
  ]
}
