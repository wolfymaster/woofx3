{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@woofx3/*": ["../*"]
    },
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["frame", "page", "tests"]
}
