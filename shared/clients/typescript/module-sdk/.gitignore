# Build output — regenerated by `bun run build` and by the publish
# pipeline. Not source-controlled (`npm publish` packs it via the
# `files` field in package.json) — EXCEPT the widget-host shim IIFE,
# which streamware serves directly and is therefore committed.
# (`dist/*` rather than `dist/` so the negation below can re-include.)
dist/*
!dist/widget-host-shim.js

# Local install artefacts.
node_modules/
*.tgz
