		return invalid("payload", "must be a JSON object")
	}
	var fields map[string]json.RawMessage
	if err := json.Unmarshal(trimmed, &fields); err != nil {
		return invalid("payload", "is not valid JSON: %v", err)
	}
	owner := make(map[string]int)
	for form, names := range forms {
		for _, name := range names {
			owner[name] = form
		}
	}
	chosen := -1
	for _, name := range sortedKeys(fields) {
		form, ok := owner[name]
		if !ok {
			return invalid("payload."+name, "unknown field")
		}
		if chosen >= 0 && form != chosen {
			return invalid("payload", "mixes fields of %s", describeForms(forms))
		}
		chosen = form
	}
	if chosen < 0 {
		if len(forms) > 1 {
			return invalid("payload", "must be one of %s", describeForms(forms))
		}
		chosen = 0
	}
	return checks[chosen](fields)
}

func describeForms(forms [][]string) string {
	described := make([]string, 0, len(forms))
	for _, names := range forms {
		described = append(described, "{"+strings.Join(names, ", ")+"}")
	}
	return strings.Join(described, " | ")
}

