    }
    if (parsedActions.includes(action)) {
      return fail(`${field}.actions[${index}]`, `names "${action}" twice`);
    }
    parsedActions.push(action);
  }
  return ok({
    id: id.value,
    displayName: displayName.value,
    state: object.state,
    connected: object.connected === true,
    enabled: object.enabled === true,
    actions: parsedActions,
  });
}

/**
 * Parses a field-options request: an object naming an action in the
 * catalog. Unknown keys are ignored.
 */
export function parseFieldOptionsRequest(value: unknown): GatewayParseResult<FieldOptionsRequest> {
  const object = asObject(value);
  if (object === undefined) {
    return fail("request", "must be an object");
  }
  const action = object.action;
  if (action === undefined || action === null || action === "") {
    return fail("action", "is required");
  }
  if (!isEgressActionId(action)) {
    return fail("action", `unknown action ${JSON.stringify(action)}`);
  }
  return ok({ action });
}

/**
 * Parses a field-options reply as a requester receives it: an array of
 * options, each naming a known platform once with a label, or an object with
 * a non-empty error.
 */
export function parseFieldOptionsReply(value: unknown): GatewayParseResult<FieldOptionsReply> {
  if (Array.isArray(value)) {
    const options: FieldOption[] = [];
    const seen: PlatformId[] = [];
    for (const [index, entry] of value.entries()) {
      const field = `[${index}]`;
      const object = asObject(entry);
      if (object === undefined) {
        return fail(field, "must be an object");
      }
      const id = readListedPlatform(object.value, `${field}.value`, seen);
      if (!id.ok) {
        return id;
      }
      const label = requireText(object, field, "label");
      if (!label.ok) {
        return label;
      }
      options.push({ value: id.value, label: label.value });
    }
    return ok(options);
  }
  const object = asObject(value);
  if (object === undefined) {
    return fail("reply", "must be an array or an object");
  }
  const error = object.error;
  if (typeof error !== "string" || error === "") {
    return fail("error", "is required");
  }
  return ok({ error });
}

/** Refuses an unknown platform, or one already in `seen`, and records it. */
function readListedPlatform(value: unknown, field: string, seen: PlatformId[]): GatewayParseResult<PlatformId> {
  if (!isPlatformId(value)) {
    return fail(field, `unknown platform ${JSON.stringify(value)}`);
  }
  if (seen.includes(value)) {
    return fail(field, `names "${value}" twice`);
  }
  seen.push(value);
  return ok(value);
}
