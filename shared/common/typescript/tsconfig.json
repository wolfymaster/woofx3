{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "baseUrl": ".",
    "paths": { "@woofx3/common/*": ["./*"] },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": [
    "logging/**/*.ts",
    "http/**/*.ts",
    "runtime/**/*.ts",
    "integrations/**/*.ts",
    "cloudevents/Companion/**/*.ts",
    "cloudevents/Barkloader/**/*.ts",
    "cloudevents/Scene/**/*.ts",
    "cloudevents/Heartbeat/**/*.ts",
    "cloudevents/Session/**/*.gen.ts",
    "cloudevents/StreamStatus/**/*.gen.ts",
    "cloudevents/contracts.test.ts"
  ]
}
