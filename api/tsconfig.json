{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@woofx3/common/*": ["../shared/common/typescript/*"],
      "@woofx3/*": ["../shared/clients/typescript/*"]
    },
    // Third-party .d.ts files are not ours to fix; capnweb's ships a rest
    // element TypeScript rejects. Checking them turns a dependency bump into
    // a broken build for code nobody here can edit.
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["bun-types"]
  },
  // The scene editor's shared sync core and its tests are not reachable from
  // api's own program, so they are named here to be checked with it.
  "include": [
    "**/*",
    "../shared/clients/typescript/api/scene-editor/**/*",
    "../shared/clients/typescript/api/tests/**/*"
  ]
}
