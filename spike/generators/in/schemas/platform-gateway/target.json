{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.woofx3.tv/contracts/platform-gateway/target.json",
  "title": "Target",
  "description": "Which platforms a request goes to; kind picks the variant.",
  "oneOf": [
    {
      "title": "TargetAll",
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "const": "all" } },
      "additionalProperties": false
    },
    {
      "title": "TargetPlatforms",
      "type": "object",
      "required": ["kind", "ids"],
      "properties": {
        "kind": { "const": "platforms" },
        "ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "../common/platform-id.json" } }
      },
      "additionalProperties": false
    },
    {
      "title": "TargetOrigin",
      "type": "object",
      "required": ["kind", "origin"],
      "properties": { "kind": { "const": "origin" }, "origin": { "$ref": "origin-ref.json" } },
      "additionalProperties": false
    }
  ]
}
