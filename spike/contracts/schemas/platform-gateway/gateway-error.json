{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.woofx3.tv/contracts/platform-gateway/gateway-error.json",
  "title": "GatewayError",
  "description": "A request the gateway refused before reaching any platform.",
  "type": "object",
  "required": ["code", "message"],
  "properties": { "code": { "$ref": "failure-code.json" }, "message": { "type": "string", "minLength": 1, "maxLength": 500 } },
  "additionalProperties": false
}
