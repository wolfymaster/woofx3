{
  "id": "woofx3",
  "name": "woofx3",
  "author": "WolfyMaster LLC",
  "version": "0.4.1",
  "category": "system",
  "description": "Bundled system module. Declares the engine's built-in actions, triggers, and widgets so they install through the same path as any other module instead of being hand-registered by each service.",
  "actions": [
    {
      "id": "function",
      "name": "Function",
      "description": "Invoke a sandboxed module function. Set `function` to the canonical function id; everything else in `parameters` is forwarded to the function as a single object argument.",
      "type": "native",
      "handler": "function",
      "taxonomy": [
        "system.workflow"
      ]
    },
    {
      "id": "alert",
      "name": "Alert",
      "description": "Publish an on-stream alert. Parameters (mediaUrl, audioUrl, text, duration, options, ...) are forwarded to subscribers on the `ui.notify.alert` NATS subject; the UI / overlays render the alert.",
      "type": "native",
      "handler": "alert",
      "taxonomy": [
        "system.workflow",
        "alert.renderer"
      ]
    },
    {
      "id": "print",
      "name": "Print",
      "description": "Log the step's parameters to the workflow service log. Useful for debugging workflow shape and expression resolution.",
      "type": "native",
      "handler": "print",
      "taxonomy": [
        "system.workflow"
      ]
    }
  ],
  "triggers": [
    {
      "id": "workflow_created",
      "name": "Workflow created",
      "description": "Fires when any workflow is created. Useful for meta-workflows that audit, mirror, or react to workflow authoring activity.",
      "type": "eventbus",
      "event": "db.workflow.created.*",
      "taxonomy": [
        "system.workflow"
      ],
      "emits": {
        "fields": [
          {
            "path": "ID",
            "type": "string",
            "description": "Workflow id."
          },
          {
            "path": "ApplicationID",
            "type": "string",
            "description": "Application the workflow belongs to."
          },
          {
            "path": "Name",
            "type": "string",
            "description": "Workflow name."
          },
          {
            "path": "Steps",
            "type": "string",
            "description": "JSON-encoded step list."
          },
          {
            "path": "Trigger",
            "type": "string",
            "description": "JSON-encoded trigger binding."
          },
          {
            "path": "Taxonomy",
            "type": "string",
            "description": "JSON-encoded classification terms."
          },
          {
            "path": "CreatedByType",
            "type": "string",
            "description": "USER for UI-authored workflows, MODULE for module-registered ones."
          },
          {
            "path": "CreatedByRef",
            "type": "string",
            "description": "Manifest module id for MODULE rows; empty for USER rows."
          },
          {
            "path": "ManifestID",
            "type": "string",
            "description": "Manifest-local workflow id for MODULE rows; empty for USER rows."
          },
          {
            "path": "Enabled",
            "type": "boolean",
            "description": "Whether the workflow runtime considers this row a candidate to run."
          }
        ]
      }
    },
    {
      "id": "workflow_updated",
      "name": "Workflow updated",
      "description": "Fires when any workflow is updated.",
      "type": "eventbus",
      "event": "db.workflow.updated.*",
      "taxonomy": [
        "system.workflow"
      ],
      "emits": {
        "fields": [
          {
            "path": "ID",
            "type": "string",
            "description": "Workflow id."
          },
          {
            "path": "ApplicationID",
            "type": "string",
            "description": "Application the workflow belongs to."
          },
          {
            "path": "Name",
            "type": "string",
            "description": "Workflow name."
          },
          {
            "path": "Steps",
            "type": "string",
            "description": "JSON-encoded step list."
          },
          {
            "path": "Trigger",
            "type": "string",
            "description": "JSON-encoded trigger binding."
          },
          {
            "path": "Taxonomy",
            "type": "string",
            "description": "JSON-encoded classification terms."
          },
          {
            "path": "CreatedByType",
            "type": "string",
            "description": "USER for UI-authored workflows, MODULE for module-registered ones."
          },
          {
            "path": "CreatedByRef",
            "type": "string",
            "description": "Manifest module id for MODULE rows; empty for USER rows."
          },
          {
            "path": "ManifestID",
            "type": "string",
            "description": "Manifest-local workflow id for MODULE rows; empty for USER rows."
          },
          {
            "path": "Enabled",
            "type": "boolean",
            "description": "Whether the workflow runtime considers this row a candidate to run."
          }
        ]
      }
    },
    {
      "id": "workflow_deleted",
      "name": "Workflow deleted",
      "description": "Fires when any workflow is deleted.",
      "type": "eventbus",
      "event": "db.workflow.deleted.*",
      "taxonomy": [
        "system.workflow"
      ],
      "emits": {
        "fields": [
          {
            "path": "ID",
            "type": "string",
            "description": "Workflow id."
          },
          {
            "path": "ApplicationID",
            "type": "string",
            "description": "Application the workflow belongs to."
          },
          {
            "path": "Name",
            "type": "string",
            "description": "Workflow name."
          },
          {
            "path": "Steps",
            "type": "string",
            "description": "JSON-encoded step list."
          },
          {
            "path": "Trigger",
            "type": "string",
            "description": "JSON-encoded trigger binding."
          },
          {
            "path": "Taxonomy",
            "type": "string",
            "description": "JSON-encoded classification terms."
          },
          {
            "path": "CreatedByType",
            "type": "string",
            "description": "USER for UI-authored workflows, MODULE for module-registered ones."
          },
          {
            "path": "CreatedByRef",
            "type": "string",
            "description": "Manifest module id for MODULE rows; empty for USER rows."
          },
          {
            "path": "ManifestID",
            "type": "string",
            "description": "Manifest-local workflow id for MODULE rows; empty for USER rows."
          },
          {
            "path": "Enabled",
            "type": "boolean",
            "description": "Whether the workflow runtime considers this row a candidate to run."
          }
        ]
      }
    },
    {
      "id": "chat_command",
      "name": "Chat command",
      "description": "Fires when a viewer runs a chat command. Bind a workflow to one command by naming it in the trigger's `command` field.",
      "type": "eventbus",
      "event": "chat.command.*",
      "taxonomy": [
        "system.chat"
      ],
      "schema": [
        {
          "id": "command",
          "label": "Command",
          "type": "text",
          "required": true,
          "placeholder": "hello",
          "description": "The command word, without its prefix (e.g. `sr` for `!sr`)."
        }
      ]
    },
    {
      "id": "module_installed",
      "name": "Module installed",
      "description": "Fires when a module is installed. Useful for workflows that announce new capabilities or seed configuration for a module as it arrives.",
      "type": "eventbus",
      "event": "module.change.add",
      "taxonomy": [
        "system.module"
      ],
      "emits": {
        "fields": [
          {
            "path": "module_id",
            "type": "string",
            "description": "Manifest-local module id."
          },
          {
            "path": "name",
            "type": "string",
            "description": "Module display name."
          },
          {
            "path": "version",
            "type": "string",
            "description": "Installed version."
          }
        ]
      }
    }
  ],
  "widgets": [
    {
      "id": "media_alert",
      "name": "Media Alert",
      "description": "Renders alert text, media, and audio with expression-based template substitution. Handles the standard stream alert events (follow, cheer, subscription, raid, channel-point redemption, stream on/off).",
      "entry": "widgets/media_alert/index.html",
      "assets": "widgets/media_alert",
      "acceptedEvents": [
        "channel.follow",
        "channel.cheer",
        "channel.subscribe",
        "channel.subscriptionGift",
        "channelpoints.redeem",
        "channel.raid",
        "stream.online",
        "stream.offline"
      ],
      "settingsSchema": [
        {
          "id": "textTemplate",
          "type": "text",
          "label": "Alert text template",
          "defaultValue": ""
        },
        {
          "id": "mediaUrlTemplate",
          "type": "text",
          "label": "Media URL template",
          "defaultValue": ""
        },
        {
          "id": "audioUrlTemplate",
          "type": "text",
          "label": "Audio URL template",
          "defaultValue": ""
        },
        {
          "id": "duration",
          "type": "number",
          "label": "Display duration (seconds)",
          "defaultValue": 5
        }
      ],
      "taxonomy": [
        "system.scene",
        "alert.renderer"
      ]
    }
  ]
}
