{
  "id": "woofx3",
  "name": "woofx3",
  "author": "WolfyMaster LLC",
  "version": "0.8.0",
  "category": "system",
  "description": "Bundled system module. Declares the engine's built-in actions, triggers, and widgets so they install through the same path as any other module instead of being hand-registered by each service.",
  "resources": [
    {
      "kind": "counter",
      "name": "Counter",
      "description": "A number that actions change and overlays and chat can show: deaths, wins, hugs given.",
      "icon": "Tally5",
      "schema": [
        {
          "id": "lifetime",
          "label": "Keeps its value",
          "type": "select",
          "required": true,
          "defaultValue": "forever",
          "options": [
            {
              "value": "forever",
              "label": "Forever"
            },
            {
              "value": "session",
              "label": "For this stream session"
            }
          ],
          "description": "A session counter goes back to its starting value when the stream session ends; a forever counter keeps counting. Changing this applies the next time the counter changes."
        },
        {
          "id": "initialValue",
          "label": "Starts at",
          "type": "number",
          "defaultValue": 0,
          "description": "Its value before anything changes it, and what Reset goes back to."
        },
        {
          "id": "step",
          "label": "Counts by",
          "type": "number",
          "min": 1,
          "defaultValue": 1,
          "description": "How much Increment adds and Decrement takes away."
        }
      ]
    }
  ],
  "functions": [
    {
      "id": "counter.increment",
      "name": "Increment counter",
      "runtime": "js",
      "path": "functions/counter.js",
      "entryPoint": "counterIncrement"
    },
    {
      "id": "counter.decrement",
      "name": "Decrement counter",
      "runtime": "js",
      "path": "functions/counter.js",
      "entryPoint": "counterDecrement"
    },
    {
      "id": "counter.set",
      "name": "Set counter",
      "runtime": "js",
      "path": "functions/counter.js",
      "entryPoint": "counterSet"
    },
    {
      "id": "counter.reset",
      "name": "Reset counter",
      "runtime": "js",
      "path": "functions/counter.js",
      "entryPoint": "counterReset"
    }
  ],
  "actions": [
    {
      "id": "function",
      "name": "Function",
      "description": "Invoke a sandboxed module function. Set `function` to the canonical function id; everything else in `parameters` is forwarded to the function as a single object argument.",
      "type": "native",
      "handler": "function",
      "taxonomy": [
        "system.workflow"
      ]
    },
    {
      "id": "chat.reply",
      "name": "Send chat message",
      "description": "Send one message to chat. Replying is an action like any other, so a chat command that answers is a command with this action on it.",
      "type": "native",
      "handler": "chat.reply",
      "schema": [
        {
          "id": "message",
          "label": "Message",
          "type": "text",
          "required": true,
          "placeholder": "What should the bot say?",
          "description": "Plain text. Twitch chat enforces a 500-character limit."
        }
      ],
      "taxonomy": [
        "system.chat"
      ]
    },
    {
      "id": "alert",
      "name": "Alert",
      "description": "Play an on-stream alert: widgets placed on a canvas, shown on every alert widget with the target name on a running scene.",
      "type": "native",
      "handler": "alert",
      "schema": [
        {
          "id": "target",
          "label": "Alert widget",
          "type": "text",
          "source": {
            "kind": "alertWidgets"
          },
          "defaultValue": "default",
          "description": "Plays on every alert widget with this name. Give alert widgets on several scenes the same name to show the same alerts on each."
        },
        {
          "id": "layout",
          "label": "Alert",
          "type": "layout",
          "surface": "alert",
          "required": true,
          "description": "What the alert shows. The alert widget scales the canvas to fit, and the alert lasts as long as its longest widget."
        }
      ],
      "taxonomy": [
        "system.workflow",
        "alert.renderer"
      ]
    },
    {
      "id": "print",
      "name": "Print",
      "description": "Log the step's parameters to the workflow service log. Useful for debugging workflow shape and expression resolution.",
      "type": "native",
      "handler": "print",
      "taxonomy": [
        "system.workflow"
      ]
    },
    {
      "id": "counter.increment",
      "name": "Increment counter",
      "description": "Add the counter's step to it.",
      "type": "function",
      "function": "counter.increment",
      "schema": [
        {
          "id": "target",
          "label": "Counter",
          "type": "resource_ref",
          "resourceKind": "counter",
          "required": true,
          "description": "Which counter to change."
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "target",
            "type": "string",
            "description": "The counter that changed."
          },
          {
            "path": "previous",
            "type": "number",
            "description": "Its value before the change."
          },
          {
            "path": "next",
            "type": "number",
            "description": "Its value after the change."
          }
        ]
      },
      "taxonomy": [
        "system.counter"
      ]
    },
    {
      "id": "counter.decrement",
      "name": "Decrement counter",
      "description": "Take the counter's step away from it.",
      "type": "function",
      "function": "counter.decrement",
      "schema": [
        {
          "id": "target",
          "label": "Counter",
          "type": "resource_ref",
          "resourceKind": "counter",
          "required": true,
          "description": "Which counter to change."
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "target",
            "type": "string",
            "description": "The counter that changed."
          },
          {
            "path": "previous",
            "type": "number",
            "description": "Its value before the change."
          },
          {
            "path": "next",
            "type": "number",
            "description": "Its value after the change."
          }
        ]
      },
      "taxonomy": [
        "system.counter"
      ]
    },
    {
      "id": "counter.set",
      "name": "Set counter",
      "description": "Set the counter to a number.",
      "type": "function",
      "function": "counter.set",
      "schema": [
        {
          "id": "target",
          "label": "Counter",
          "type": "resource_ref",
          "resourceKind": "counter",
          "required": true,
          "description": "Which counter to change."
        },
        {
          "id": "value",
          "label": "Value",
          "type": "number",
          "required": true,
          "description": "The number to set it to."
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "target",
            "type": "string",
            "description": "The counter that changed."
          },
          {
            "path": "previous",
            "type": "number",
            "description": "Its value before the change."
          },
          {
            "path": "next",
            "type": "number",
            "description": "Its value after the change."
          }
        ]
      },
      "taxonomy": [
        "system.counter"
      ]
    },
    {
      "id": "counter.reset",
      "name": "Reset counter",
      "description": "Put the counter back to the value it starts at.",
      "type": "function",
      "function": "counter.reset",
      "schema": [
        {
          "id": "target",
          "label": "Counter",
          "type": "resource_ref",
          "resourceKind": "counter",
          "required": true,
          "description": "Which counter to change."
        }
      ],
      "returns": {
        "fields": [
          {
            "path": "target",
            "type": "string",
            "description": "The counter that changed."
          },
          {
            "path": "previous",
            "type": "number",
            "description": "Its value before the change."
          },
          {
            "path": "next",
            "type": "number",
            "description": "Its value after the change."
          }
        ]
      },
      "taxonomy": [
        "system.counter"
      ]
    }
  ],
  "triggers": [
    {
      "id": "workflow_created",
      "name": "Workflow created",
      "description": "Fires when any workflow is created. Useful for meta-workflows that audit, mirror, or react to workflow authoring activity.",
      "type": "eventbus",
      "event": "db.workflow.created.*",
      "taxonomy": [
        "system.workflow"
      ],
      "emits": {
        "fields": [
          {
            "path": "ID",
            "type": "string",
            "description": "Workflow id."
          },
          {
            "path": "ApplicationID",
            "type": "string",
            "description": "Application the workflow belongs to."
          },
          {
            "path": "Name",
            "type": "string",
            "description": "Workflow name."
          },
          {
            "path": "Steps",
            "type": "string",
            "description": "JSON-encoded step list."
          },
          {
            "path": "Trigger",
            "type": "string",
            "description": "JSON-encoded trigger binding."
          },
          {
            "path": "Taxonomy",
            "type": "string",
            "description": "JSON-encoded classification terms."
          },
          {
            "path": "CreatedByType",
            "type": "string",
            "description": "USER for UI-authored workflows, MODULE for module-registered ones."
          },
          {
            "path": "CreatedByRef",
            "type": "string",
            "description": "Manifest module id for MODULE rows; empty for USER rows."
          },
          {
            "path": "ManifestID",
            "type": "string",
            "description": "Manifest-local workflow id for MODULE rows; empty for USER rows."
          },
          {
            "path": "Enabled",
            "type": "boolean",
            "description": "Whether the workflow runtime considers this row a candidate to run."
          }
        ]
      }
    },
    {
      "id": "workflow_updated",
      "name": "Workflow updated",
      "description": "Fires when any workflow is updated.",
      "type": "eventbus",
      "event": "db.workflow.updated.*",
      "taxonomy": [
        "system.workflow"
      ],
      "emits": {
        "fields": [
          {
            "path": "ID",
            "type": "string",
            "description": "Workflow id."
          },
          {
            "path": "ApplicationID",
            "type": "string",
            "description": "Application the workflow belongs to."
          },
          {
            "path": "Name",
            "type": "string",
            "description": "Workflow name."
          },
          {
            "path": "Steps",
            "type": "string",
            "description": "JSON-encoded step list."
          },
          {
            "path": "Trigger",
            "type": "string",
            "description": "JSON-encoded trigger binding."
          },
          {
            "path": "Taxonomy",
            "type": "string",
            "description": "JSON-encoded classification terms."
          },
          {
            "path": "CreatedByType",
            "type": "string",
            "description": "USER for UI-authored workflows, MODULE for module-registered ones."
          },
          {
            "path": "CreatedByRef",
            "type": "string",
            "description": "Manifest module id for MODULE rows; empty for USER rows."
          },
          {
            "path": "ManifestID",
            "type": "string",
            "description": "Manifest-local workflow id for MODULE rows; empty for USER rows."
          },
          {
            "path": "Enabled",
            "type": "boolean",
            "description": "Whether the workflow runtime considers this row a candidate to run."
          }
        ]
      }
    },
    {
      "id": "workflow_deleted",
      "name": "Workflow deleted",
      "description": "Fires when any workflow is deleted.",
      "type": "eventbus",
      "event": "db.workflow.deleted.*",
      "taxonomy": [
        "system.workflow"
      ],
      "emits": {
        "fields": [
          {
            "path": "ID",
            "type": "string",
            "description": "Workflow id."
          },
          {
            "path": "ApplicationID",
            "type": "string",
            "description": "Application the workflow belongs to."
          },
          {
            "path": "Name",
            "type": "string",
            "description": "Workflow name."
          },
          {
            "path": "Steps",
            "type": "string",
            "description": "JSON-encoded step list."
          },
          {
            "path": "Trigger",
            "type": "string",
            "description": "JSON-encoded trigger binding."
          },
          {
            "path": "Taxonomy",
            "type": "string",
            "description": "JSON-encoded classification terms."
          },
          {
            "path": "CreatedByType",
            "type": "string",
            "description": "USER for UI-authored workflows, MODULE for module-registered ones."
          },
          {
            "path": "CreatedByRef",
            "type": "string",
            "description": "Manifest module id for MODULE rows; empty for USER rows."
          },
          {
            "path": "ManifestID",
            "type": "string",
            "description": "Manifest-local workflow id for MODULE rows; empty for USER rows."
          },
          {
            "path": "Enabled",
            "type": "boolean",
            "description": "Whether the workflow runtime considers this row a candidate to run."
          }
        ]
      }
    },
    {
      "id": "chat_command",
      "name": "Chat command",
      "description": "Fires when a viewer runs a chat command. Bind a workflow to one command by naming it in the trigger's `command` field.",
      "type": "eventbus",
      "event": "chat.command.*",
      "taxonomy": [
        "system.chat"
      ],
      "schema": [
        {
          "id": "command",
          "label": "Command",
          "type": "text",
          "required": true,
          "placeholder": "hello",
          "description": "The command word, without its prefix (e.g. `sr` for `!sr`)."
        }
      ]
    },
    {
      "id": "module_installed",
      "name": "Module installed",
      "description": "Fires when a module is installed. Useful for workflows that announce new capabilities or seed configuration for a module as it arrives.",
      "type": "eventbus",
      "event": "module.change.add",
      "taxonomy": [
        "system.module"
      ],
      "emits": {
        "fields": [
          {
            "path": "module_id",
            "type": "string",
            "description": "Manifest-local module id."
          },
          {
            "path": "name",
            "type": "string",
            "description": "Module display name."
          },
          {
            "path": "version",
            "type": "string",
            "description": "Installed version."
          }
        ]
      }
    }
  ],
  "widgets": [
    {
      "id": "alert",
      "name": "Alert",
      "description": "Where alerts play on this scene. Alert actions target alert widgets by name, and play one alert at a time.",
      "surfaces": [
        "scene"
      ],
      "hostsSurface": "alert",
      "settingsSchema": [
        {
          "id": "name",
          "label": "Name",
          "type": "text",
          "required": true,
          "defaultValue": "default",
          "description": "Alert actions that target this name play here."
        }
      ],
      "taxonomy": [
        "alert"
      ]
    },
    {
      "id": "text",
      "name": "Text",
      "description": "Styled text. Wrap words in {primary}...{primary} to show them in the highlight color.",
      "entry": "widgets/text/index.html",
      "assets": "widgets/text",
      "surfaces": [
        "scene",
        "alert"
      ],
      "settingsSchema": [
        {
          "id": "text",
          "label": "Text",
          "type": "text",
          "placeholder": "Thanks for the follow, {primary}name{primary}!",
          "description": "Wrap words in {primary}...{primary} to show them in the highlight color."
        },
        {
          "id": "color",
          "label": "Color",
          "type": "color",
          "defaultValue": "#ffffff"
        },
        {
          "id": "highlightColor",
          "label": "Highlight color",
          "type": "color",
          "defaultValue": "#ec6758"
        },
        {
          "id": "fontFamily",
          "label": "Font",
          "type": "text",
          "defaultValue": "Roboto, system-ui, sans-serif"
        },
        {
          "id": "fontSize",
          "label": "Font size",
          "type": "number",
          "unit": "px",
          "min": 1,
          "defaultValue": 48
        },
        {
          "id": "align",
          "label": "Alignment",
          "type": "select",
          "defaultValue": "center",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "id": "duration",
          "label": "Duration",
          "type": "number",
          "unit": "seconds",
          "min": 0,
          "defaultValue": 0,
          "description": "In an alert: how long the text shows. 0 keeps it up for the whole alert."
        }
      ],
      "taxonomy": [
        "text"
      ]
    },
    {
      "id": "image",
      "name": "Image",
      "description": "An image or animated GIF.",
      "entry": "widgets/image/index.html",
      "assets": "widgets/image",
      "surfaces": [
        "scene",
        "alert"
      ],
      "settingsSchema": [
        {
          "id": "src",
          "label": "Image",
          "type": "media",
          "mediaType": "image",
          "required": true
        },
        {
          "id": "fit",
          "label": "Fit",
          "type": "select",
          "defaultValue": "contain",
          "options": [
            {
              "value": "contain",
              "label": "Fit inside"
            },
            {
              "value": "cover",
              "label": "Fill and crop"
            },
            {
              "value": "fill",
              "label": "Stretch"
            }
          ]
        },
        {
          "id": "duration",
          "label": "Duration",
          "type": "number",
          "unit": "seconds",
          "min": 0,
          "defaultValue": 0,
          "description": "In an alert: how long the image shows. 0 keeps it up for the whole alert."
        }
      ],
      "taxonomy": [
        "media.image"
      ]
    },
    {
      "id": "video",
      "name": "Video",
      "description": "A video clip that plays once per alert.",
      "entry": "widgets/video/index.html",
      "assets": "widgets/video",
      "surfaces": [
        "alert"
      ],
      "settingsSchema": [
        {
          "id": "src",
          "label": "Video",
          "type": "media",
          "mediaType": "video",
          "required": true
        },
        {
          "id": "fit",
          "label": "Fit",
          "type": "select",
          "defaultValue": "contain",
          "options": [
            {
              "value": "contain",
              "label": "Fit inside"
            },
            {
              "value": "cover",
              "label": "Fill and crop"
            },
            {
              "value": "fill",
              "label": "Stretch"
            }
          ]
        },
        {
          "id": "volume",
          "label": "Volume",
          "type": "number",
          "unit": "%",
          "min": 0,
          "max": 100,
          "defaultValue": 100
        },
        {
          "id": "loop",
          "label": "Loop",
          "type": "toggle",
          "defaultValue": false,
          "description": "Loop the video for as long as the rest of the alert lasts, instead of playing it once."
        },
        {
          "id": "duration",
          "label": "Duration",
          "type": "number",
          "unit": "seconds",
          "min": 0,
          "defaultValue": 0,
          "description": "How long the video shows, looping if it is shorter. 0 plays it once, or loops for the rest of the alert when Loop is on."
        }
      ],
      "taxonomy": [
        "media.video"
      ]
    },
    {
      "id": "audio",
      "name": "Audio",
      "description": "A sound that plays once per alert.",
      "entry": "widgets/audio/index.html",
      "assets": "widgets/audio",
      "surfaces": [
        "alert"
      ],
      "settingsSchema": [
        {
          "id": "src",
          "label": "Sound",
          "type": "media",
          "mediaType": "audio",
          "required": true
        },
        {
          "id": "volume",
          "label": "Volume",
          "type": "number",
          "unit": "%",
          "min": 0,
          "max": 100,
          "defaultValue": 100
        },
        {
          "id": "duration",
          "label": "Duration",
          "type": "number",
          "unit": "seconds",
          "min": 0,
          "defaultValue": 0,
          "description": "How long the sound plays. 0 plays all of it."
        }
      ],
      "taxonomy": [
        "media.audio"
      ]
    },
    {
      "id": "lottie",
      "name": "Lottie",
      "description": "A Lottie animation, optionally with the text of one of its text layers replaced.",
      "entry": "widgets/lottie/index.html",
      "assets": "widgets/lottie",
      "surfaces": [
        "scene",
        "alert"
      ],
      "settingsSchema": [
        {
          "id": "src",
          "label": "Animation",
          "type": "media",
          "required": true,
          "description": "A Lottie JSON file."
        },
        {
          "id": "textLayer",
          "label": "Text layer",
          "type": "text",
          "description": "The name of a text layer in the animation whose text to replace."
        },
        {
          "id": "text",
          "label": "Text",
          "type": "text",
          "description": "The text the layer shows instead."
        },
        {
          "id": "loop",
          "label": "Loop",
          "type": "toggle",
          "defaultValue": true,
          "description": "On a scene: loop the animation."
        },
        {
          "id": "duration",
          "label": "Duration",
          "type": "number",
          "unit": "seconds",
          "min": 0,
          "defaultValue": 0,
          "description": "In an alert: how long the animation plays, looping if it is shorter. 0 plays it through once."
        }
      ],
      "taxonomy": [
        "media.animation"
      ]
    }
  ]
}
