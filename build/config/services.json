{
  "services": [
    {
      "enabled": true,
      "entry": "src/server.ts",
      "name": "api",
      "dependencies": ["message-bus", "db-proxy", "barkloader"],
      "health_endpoint": "http://127.0.0.1:${WOOFX3_API_PORT:-5050}/ready",
      "output": "api",
      "path": "../api",
      "type": "bun"
    },
    {
      "enabled": true,
      "name": "barkloader",
      "dependencies": ["message-bus", "db-proxy"],
      "output": "barkloader",
      "path": "../barkloader",
      "type": "rust"
    },
    {
      "name": "connectors",
      "dependencies": ["message-bus", "db-proxy"],
      "health_endpoint": "http://127.0.0.1:${WOOFX3_CONNECTORS_PORT:-9102}/health",
      "type": "bun",
      "path": "../connectors",
      "enabled": true,
      "entry": "src/server.ts",
      "output": "connectors"
    },
    {
      "name": "db-proxy",
      "dependencies": ["migrate"],
      "type": "go",
      "path": "../db",
      "enabled": true,
      "output": "db-proxy"
    },
    {
      "name": "migrate",
      "type": "go",
      "path": "../db",
      "enabled": true,
      "entry": "./database/migrate",
      "output": "migrate",
      "args": ["-cmd", "up"],
      "run_once": true
    },
    {
      "name": "message-bus",
      "type": "go",
      "path": "../services/nats",
      "enabled": true,
      "output": "messagebus"
    },
    {
      "name": "sceneManager",
      "dependencies": ["message-bus", "db-proxy"],
      "health_endpoint": "http://127.0.0.1:${WOOFX3_SCENE_MANAGER_PORT:-9101}/health",
      "type": "bun",
      "path": "../sceneManager",
      "enabled": true,
      "entry": "src/server.ts",
      "output": "sceneManager",
      "assets": "public"
    },
    {
      "name": "wooflow",
      "dependencies": ["message-bus", "db-proxy"],
      "type": "go",
      "path": "../workflow",
      "enabled": true,
      "output": "wooflow"
    },
    {
      "name": "edge",
      "dependencies": ["api", "sceneManager"],
      "type": "binary",
      "enabled": true,
      "output": "caddy",
      "args": ["run", "--config", "Caddyfile.edge", "--adapter", "caddyfile"]
    }
  ],
  "build": {
    "output_dir": "./dist",
    "targets": ["linux-amd64", "windows-amd64"]
  }
}
