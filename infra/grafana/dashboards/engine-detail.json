      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, platform) (rate(woofx3_event_ingest_lag_seconds_bucket{service_namespace=~\"$engine\"}[$__rate_interval])))",
          "legendFormat": "p50 {{platform}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, platform) (rate(woofx3_event_ingest_lag_seconds_bucket{service_namespace=~\"$engine\"}[$__rate_interval])))",
          "legendFormat": "p95 {{platform}}"
        }
