    "@woofx3/module-sdk": "file:../shared/clients/typescript/module-sdk",
    "@woofx3/nats": "file:../shared/clients/typescript/nats",
    "jose": "^5.9.6",
    "obs-websocket-js": "^5.0.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
